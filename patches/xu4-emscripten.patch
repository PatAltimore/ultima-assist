 #define MAX_CURSORS 4
 
@@ -303,6 +306,73 @@ static void scrollHandler(GLFWwindow* win, double x, double y)
     dispatchEvent(&ie);
 }
 
+#ifdef __EMSCRIPTEN__
+/*
+ * ultima-assist: Under Emscripten the GLFW callbacks run from the browser's
+ * event loop, not from inside glfwPollEvents().  xu4's handlers can start
+ * nested blocking loops (e.g. IntroController::initiateNewGame), which call
+ * emscripten_sleep(); doing that from a callback while main() is already
+ * suspended by Asyncify corrupts memory.  So the callbacks only queue the
+ * event, and handleInputEvents() replays the queue on the main stack.
+ */
+struct QueuedEvent {
+    int type;       // 0 key, 1 mouse move, 2 mouse button, 3 scroll
+    int a, b, c, d;
+    double x, y;
+};
+
+#define EVQ_SIZE 256
+static QueuedEvent evQueue[EVQ_SIZE];
+static int evHead, evTail;
+
+static void queueEvent(const QueuedEvent& e)
+{
+    int next = (evHead + 1) % EVQ_SIZE;
+    if (next == evTail)
+        return;     // Full: drop.
+    evQueue[evHead] = e;
+    evHead = next;
+}
+
+static void keyQueue(GLFWwindow*, int token, int scancode, int action, int mods)
+{
+    QueuedEvent e = {0, token, scancode, action, mods, 0.0, 0.0};
+    queueEvent(e);
+}
+
+static void mouseMotionQueue(GLFWwindow*, double x, double y)
+{
+    QueuedEvent e = {1, 0, 0, 0, 0, x, y};
+    queueEvent(e);
+}
+
+static void mouseButtonQueue(GLFWwindow*, int button, int action, int mods)
+{
+    QueuedEvent e = {2, button, action, mods, 0, 0.0, 0.0};
+    queueEvent(e);
+}
+
+static void scrollQueue(GLFWwindow*, double x, double y)
+{
+    QueuedEvent e = {3, 0, 0, 0, 0, x, y};
+    queueEvent(e);
+}
+
+static void flushQueuedEvents(GLFWwindow* win)
+{
+    while (evTail != evHead) {
+        QueuedEvent e = evQueue[evTail];
+        evTail = (evTail + 1) % EVQ_SIZE;
+        switch (e.type) {
+            case 0: keyHandler(win, e.a, e.b, e.c, e.d); break;
+            case 1: mouseMotionHandler(win, e.x, e.y); break;
+            case 2: mouseButtonHandler(win, e.a, e.b, e.c); break;
+            case 3: scrollHandler(win, e.x, e.y); break;
+        }
+    }
+}
+#endif
+
 extern int screenInitState(ScreenState*, const Settings*, int dw, int dh);
 
 void screenInit_sys(const Settings* settings, ScreenState* state, int reset)
@@ -384,10 +454,17 @@ void screenInit_sys(const Settings* settings, ScreenState* state, int reset)
